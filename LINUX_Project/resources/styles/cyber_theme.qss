/* ===== КИБЕРПАНК СЕТКА ===== */
/* Глобальный фон для всех виджетов */
QWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0a0a12,
        stop:1 #0a0a20) !important;
    color: #00ffff !important;
}

/* Убираем фоны у всех кнопок (только градиент) */
QPushButton {
    background: transparent; /* Убираем фон */
    border: 2px solid #ff00ff;
    color: #00ffff;
    font-size: 14px;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px 20px;
}

QPushButton:hover {
    background: rgba(255, 0, 255, 0.15); /* Полупрозрачный */
    border-color: #00ffff;
    color: #ff00ff;
}

QPushButton:pressed {
    background: rgba(255, 0, 255, 0.3);
    color: #00ffff;
    border-color: #00ffff;
}

/* Кнопка "Играть" - неоновый фон */
QPushButton#playButton {
    background: #ff00ff;
    color: #00ffff;
    border-color: #00ffff;
    font-size: 18px;
}

QPushButton#playButton:hover {
    background: #00ffff;
    color: #ff00ff;
    border-color: #ff00ff;
}

/* Кнопка выхода */
QPushButton#exitButton {
    border-color: #ff0044;
    color: #ff0044;
}

QPushButton#exitButton:hover {
    background: rgba(255, 0, 68, 0.2);
    color: #00ffff;
    border-color: #00ffff;
}

/* Кнопка "Сохранить" */
QPushButton#saveButton {
    border-color: #00ff44;
    color: #00ff44;
}

QPushButton#saveButton:hover {
    background: rgba(0, 255, 68, 0.2);
    color: #ff00ff;
    border-color: #ff00ff;
}

/* Кнопка "По умолчанию" */
QPushButton#defaultButton {
    border-color: #ff8800;
    color: #ff8800;
}

QPushButton#defaultButton:hover {
    background: rgba(255, 136, 0, 0.2);
    color: #00ffff;
    border-color: #00ffff;
}

/* Слайдеры */
QSlider::groove:horizontal {
    height: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff00ff,
        stop:0.33 #00ffff,
        stop:0.66 #ff0044,
        stop:1 #ff00ff);
    border-radius: 4px;
    border: 1px solid #ff00ff;
}

QSlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 #ffffff,
        stop:0.5 #ff00ff,
        stop:1 #00ffff);
    width: 22px;
    height: 22px;
    margin: -7px 0;
    border-radius: 11px;
    border: 2px solid #00ffff;
}

QSlider::handle:horizontal:hover {
    border-color: #ff00ff;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff00ff,
        stop:0.5 #00ffff,
        stop:1 #ff0044);
    border-radius: 4px;
}

QSlider::add-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff0044,
        stop:0.5 #ff00ff,
        stop:1 #00ffff);
    border-radius: 4px;
}

/* Метки */
QLabel {
    color: #00ffff;
    font-size: 14px;
    font-weight: bold;
}

QLabel[class="valueLabel"] {
    color: #ff00ff;
    font-size: 16px;
    font-weight: bold;
}

/* Радио-кнопки */
QRadioButton {
    color: #00ffff;
    font-size: 14px;
    font-weight: bold;
    spacing: 10px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #ff00ff;
    background: transparent;
}

QRadioButton::indicator:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        stop:0 #00ffff,
        stop:0.5 #ff00ff,
        stop:1 transparent);
    border-color: #00ffff;
}

QRadioButton::indicator:hover {
    border-color: #00ffff;
}