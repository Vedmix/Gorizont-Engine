/* ===== СВЕТЛАЯ ТЕМА ===== */
/* Основные цвета */
QWidget {
    background-color: #f0ece6;
    color: #2d2d2d;
}

QMainWindow {
    background-color: #f0ece6;
}

SettingsWindow, CreditsWindow {
    background-color: #f0ece6;
}

/* Кнопки */
QPushButton {
    background-color: #e8e4de;
    border: 2px solid #4CAF50;
    color: #2d2d2d;
    font-size: 14px;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #4CAF50;
    color: #ffffff;
    border-color: #66bb6a;
}

QPushButton:pressed {
    background-color: #388e3c;
    border-color: #2e7d32;
    color: white;
}

QPushButton#playButton {
    background-color: #4CAF50;
    color: white;
    border-color: #66bb6a;
    font-size: 16px;
}

QPushButton#playButton:hover {
    background-color: #66bb6a;
    border-color: #81c784;
}

QPushButton#exitButton {
    border-color: #e74c3c;
}

QPushButton#exitButton:hover {
    background-color: #e74c3c;
    border-color: #ff6b6b;
    color: white;
}

/* Слайдеры */
QSlider::groove:horizontal {
    height: 6px;
    background: #d5d0ca;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #4CAF50;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
    border: 2px solid #66bb6a;
}

QSlider::handle:horizontal:hover {
    background: #66bb6a;
    border-color: #81c784;
}

QSlider::sub-page:horizontal {
    background: #4CAF50;
    border-radius: 3px;
}

/* Метки - теперь как текст на кнопках */
QLabel {
    color: #2d2d2d;
    font-size: 14px;
    font-weight: bold;
}

QLabel[class="valueLabel"] {
    color: #4CAF50;
    font-size: 14px;
    font-weight: bold;
}

/* Радио-кнопки */
QRadioButton {
    color: #2d2d2d;
    font-size: 14px;
    font-weight: bold;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #b0aaa4;
    background: #ffffff;
}

QRadioButton::indicator:checked {
    background: #4CAF50;
    border-color: #4CAF50;
}

QRadioButton::indicator:hover {
    border-color: #66bb6a;
}